<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>com.fs.generateCommitMessage</id>
    <name>Generate Commit Message</name>
    <vendor url="https://github.com/hwglhj/generateCommitMessage">hwglhj</vendor>

    <description><![CDATA[
AI-powered Git commit message generator with CLI tools integration.

Features:
- Generate high-quality commit messages using AI CLIs (Claude, Codex, Cursor, OpenCode, Gemini, Grok, OMP, Pi)
- CLI mode reuses each tool's login. API mode supports OpenAI-compatible and Anthropic services with multiple configurations and PasswordSafe key storage.
- Customizable prompts, recent-commit style reference, diff length limit and output language (Chinese / English)
- Integrated CLI terminal tools sidebar with per-tool visibility and supported high-permission startup
- Independent Chinese / English interface and commit message language
- Windows npm / nvm detection and process cancellation
- External editor jump support: VS Code, Cursor, Antigravity and Windsurf

Based on l-ning/cli-tools-idea. Requires IntelliJ IDEA 2022.2 or later with the Terminal plugin.
]]></description>

    <change-notes><![CDATA[
        <h3>1.0.0</h3>
        <ul>
            <li>首次发布：AI Commit 生成 + CLI Tools 侧边栏</li>
            <li>统一配置界面：Settings → Tools → Generate Commit Message，AI Commit / CLI Tools 两个标签页</li>
            <li>AI Commit 增强选项：近期提交风格参考、Diff 最大长度、输出语言（中文/英文）</li>
            <li>重建第三方 API 多配置、PasswordSafe 密钥存储、模型获取与连接测试</li>
            <li>恢复独立中英文界面和外部编辑器选择，修复 Windows 进程启动与设置状态</li>
        </ul>
    ]]></change-notes>

    <version>1.0.0</version>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <actions>
        <action id="com.fs.ShowInFinder"
                class="com.fs.ShowInFinderAction"
                text="Open in External Editor"
                description="Open current file in the configured external editor">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="shift meta P"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="shift meta P"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="shift meta P"/>
        </action>
        <action id="com.fs.aicommit.GenerateCommitMessage"
                class="com.fs.aicommit.GenerateCommitMessageAction"
                text="Generate Commit Message"
                description="使用 AI 根据选中的变更生成 commit message"
                icon="AllIcons.Actions.Lightning">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="last"/>
        </action>
        <action id="com.fs.aicommit.QuickModel"
                class="com.fs.aicommit.QuickModelAction"
                text="Switch Commit Model"
                description="Switch the model used to generate commit messages"
                icon="AllIcons.Actions.ListChanges">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="before" relative-to-action="com.fs.aicommit.GenerateCommitMessage"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.fs.aicommit.AiCommitSettings"/>
        <notificationGroup id="RestfulToolkit.AiCommit" displayType="BALLOON"/>
        <applicationService serviceImplementation="com.fs.terminal.CliToolsSettings"/>
        <toolWindow id="Claude" anchor="right" secondary="false"
                    icon="/icons/claude.svg"
                    factoryClass="com.fs.terminal.ClaudeToolWindowFactory"/>
        <toolWindow id="Codex" anchor="right" secondary="false"
                    icon="/icons/codex.svg"
                    factoryClass="com.fs.terminal.CodexToolWindowFactory"/>
        <toolWindow id="Cursor" anchor="right" secondary="false"
                    icon="/icons/cursor.svg"
                    factoryClass="com.fs.terminal.CursorToolWindowFactory"/>
        <toolWindow id="OpenCode" anchor="right" secondary="false"
                    icon="/icons/opencode.svg"
                    factoryClass="com.fs.terminal.OpenCodeToolWindowFactory"/>
        <toolWindow id="Antigravity" anchor="right" secondary="false"
                    icon="/icons/antigravity.svg"
                    factoryClass="com.fs.terminal.AntigravityToolWindowFactory"/>
        <toolWindow id="Grok" anchor="right" secondary="false"
                    icon="/icons/grok.svg"
                    factoryClass="com.fs.terminal.GrokToolWindowFactory"/>
        <toolWindow id="OMP" anchor="right" secondary="false"
                    icon="/icons/omp.svg"
                    factoryClass="com.fs.terminal.OmpToolWindowFactory"/>
        <toolWindow id="Pi" anchor="right" secondary="false"
                    icon="/icons/pi.svg"
                    factoryClass="com.fs.terminal.PiToolWindowFactory"/>
        <fileEditorProvider implementation="com.fs.terminal.TerminalFileEditorProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="tools"
            instance="com.fs.aicommit.GenerateCommitMessageConfigurable"
            id="com.fs.aicommit.GenerateCommitMessageConfigurable"
            displayName="Generate Commit Message"/>
    </extensions>
</idea-plugin>
